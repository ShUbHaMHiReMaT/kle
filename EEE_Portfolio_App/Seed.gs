function importRoster2026() {
  ensureSetup_();
  const res = importRoster_(null);
  Logger.log(JSON.stringify(res, null, 2));
  return res;
}

function importRoster_(ctx) {
  const out = { facultyAdded: 0, teamsAdded: 0, teamsUpdated: 0, studentsAdded: 0, studentsUpdated: 0 };
  const t = now_();
  // 1. Guides (matched by name)
  const facByName = {};
  all_('Faculty').forEach(f => facByName[String(f.name).toLowerCase()] = f.id);
  ROSTER_2026.forEach(g => {
    const k = g.guide.toLowerCase();
    if (!facByName[k]) {
      const id = uid_('fac');
      insert_('Faculty', { id: id, name: g.guide, email: '', designation: /^Dr\./.test(g.guide) ? 'Faculty (Ph.D.)' : 'Faculty', phone: '', role: 'Faculty', active: 'true', createdAt: t, updatedAt: t });
      facByName[k] = id; out.facultyAdded++;
    }
  });
  // 2. Teams (matched by name "Team N")
  const teamByName = {};
  all_('Teams').forEach(x => teamByName[String(x.name).toLowerCase()] = x);
  ROSTER_2026.forEach(g => {
    const name = 'Team ' + g.team;
    const ex = teamByName[name.toLowerCase()];
    const row = { title: g.title, guideId: facByName[g.guide.toLowerCase()], updatedAt: t };
    if (g.themeId) row.themeId = g.themeId;
    if (g.artefact) row.artefact = g.artefact;
    if (ex) {
      // never overwrite values the admin already set
      Object.keys(row).forEach(k => { if (k !== 'updatedAt' && ex[k]) delete row[k]; });
      update_('Teams', ex._row, row); g._id = ex.id; out.teamsUpdated++;
    } else {
      g._id = uid_('team');
      insert_('Teams', Object.assign({ id: g._id, name: name, themeId: '', artefact: '', coGuideId: '', reviewerIds: '', folderId: '', apiKeyId: '', model: '', status: 'Active', createdAt: t }, row));
      out.teamsAdded++;
    }
  });
  // 3. Students (matched by SRN)
  const stuBySrn = {};
  all_('Students').forEach(s => stuBySrn[String(s.usn).toUpperCase()] = s);
  ROSTER_2026.forEach(g => g.members.forEach(m => {
    const ex = stuBySrn[m[0]];
    if (ex) { update_('Students', ex._row, { teamId: ex.teamId || g._id, name: ex.name || m[1], updatedAt: t }); out.studentsUpdated++; }
    else { insert_('Students', { id: uid_('stu'), usn: m[0], name: m[1], email: '', teamId: g._id, active: 'true', createdAt: t, updatedAt: t }); out.studentsAdded++; }
  }));
  // 4. Drive evidence folders
  all_('Teams').forEach(x => { try { teamFolder_(x); } catch (e) { /* created on first upload */ } });
  audit_(ctx, 'importRoster2026', '', out);
  return out;
}
